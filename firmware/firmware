
#define SER_PIN   PIN_PA1  
#define SRCLK_PIN PIN_PA3   
#define RCLK_PIN  PIN_PA4   
#define OE_PIN    PIN_PB0  
#define BTN_PIN   PIN_PA6   

#define NUM_MODES 4
#define ALL_LEDS  0x1FFF    

uint8_t mode = 0;

void shiftByte(uint8_t b) {
  for (int8_t i = 7; i >= 0; i--) {
    digitalWrite(SER_PIN, (b >> i) & 1);
    digitalWrite(SRCLK_PIN, HIGH);
    digitalWrite(SRCLK_PIN, LOW);
  }
}

void show(uint16_t leds) {
  shiftByte((leds >> 7) & 0x3F);  
  shiftByte(leds & 0x7F);         
  digitalWrite(RCLK_PIN, HIGH);
  digitalWrite(RCLK_PIN, LOW);
}

void setBrightness(uint8_t b) {
  analogWrite(OE_PIN, 255 - b);
}

bool wait(uint16_t ms) {
  while (ms--) {
    if (digitalRead(BTN_PIN) == LOW) {
      delay(30);
      if (digitalRead(BTN_PIN) == LOW) {
        mode = (mode + 1) % NUM_MODES;
        while (digitalRead(BTN_PIN) == LOW) {}  
        return true;
      }
    }
    delay(1);
  }
  return false;
}

void chase() {
  for (uint8_t i = 0; i < 13; i++) {
    show(1UL << i);
    if (wait(80)) return;
  }
  for (int8_t i = 11; i > 0; i--) {
    show(1UL << i);
    if (wait(80)) return;
  }
}

void fill() {
  uint16_t leds = 0;
  for (uint8_t i = 0; i < 13; i++) {
    leds |= (1UL << i);
    show(leds);
    if (wait(70)) return;
  }
  if (wait(300)) return;
  for (uint8_t i = 0; i < 13; i++) {
    leds &= ~(1UL << i);
    show(leds);
    if (wait(70)) return;
  }
}

void alternate() {
  show(0x1555);
  if (wait(250)) return;
  show(0x0AAA);
  wait(250);
}

void breathe() {
  show(ALL_LEDS);
  for (int16_t b = 0; b <= 255; b += 5) {
    setBrightness(b);
    if (wait(10)) return;
  }
  for (int16_t b = 255; b >= 0; b -= 5) {
    setBrightness(b);
    if (wait(10)) return;
  }
}

void setup() {
  pinMode(OE_PIN, OUTPUT);
  digitalWrite(OE_PIN, HIGH);  // LEDs off while starting
  pinMode(SER_PIN, OUTPUT);
  pinMode(SRCLK_PIN, OUTPUT);
  pinMode(RCLK_PIN, OUTPUT);
  pinMode(BTN_PIN, INPUT_PULLUP);

  show(0);
  setBrightness(255);
}

void loop() {
  if (mode != 3) setBrightness(255);
  switch (mode) {
    case 0: chase(); break;
    case 1: fill(); break;
    case 2: alternate(); break;
    case 3: breathe(); break;
  }
}
